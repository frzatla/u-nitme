{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mock student period enrolments",
  "type": "object",
  "required": ["version", "label", "enrolments"],
  "properties": {
    "version": { "type": "integer" },
    "label": {
      "type": "string",
      "enum": ["previous_semester", "current_semester"]
    },
    "enrolments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "student_id",
          "unit_code",
          "period",
          "mark",
          "grade",
          "grade_point"
        ],
        "properties": {
          "student_id": { "type": "string", "pattern": "^S\\d{4}$" },
          "unit_code": { "type": "string", "pattern": "^[A-Z]{2,4}\\d{4}$" },
          "period": {
            "type": "string",
            "enum": ["previous_semester", "current_semester"]
          },
          "mark": { "type": "integer", "minimum": 0, "maximum": 100 },
          "grade": { "type": "string", "enum": ["HD", "D", "C", "P", "N"] },
          "grade_point": { "type": "number", "minimum": 0, "maximum": 4 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
